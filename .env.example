# ──────────────────────────────────────────────────────────────────────────────
#  KIA DropAgentX — Environment Configuration
#  Copy this file to `.env` and fill in the values.
#  On Railway: add these key/value pairs in your service → Variables tab.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# SQLite database (relative to the prisma/ folder).
# On Railway mount a Volume at /app/db and keep this value as-is.
DATABASE_URL=file:../db/kia.db

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Get a token from @BotFather. Leave empty to run in WEB-ONLY mode (dashboard without bot).
BOT_TOKEN=
# Your bot username without @ (used for referral links and deep-links)
BOT_USERNAME=MyKiaDropBot

# Public HTTPS URL Railway gives you (e.g. https://kiadropagentx.up.railway.app)
# When set, the bot auto-registers a Telegram webhook. When empty → long-polling (dev).
PUBLIC_URL=

# Random secret used to authenticate Telegram webhook calls (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated Telegram numeric IDs of the owner(s) — full control, HITL approver.
OWNER_IDS=123456789
# Comma-separated extra admin IDs (can review approvals, manage products).
ADMIN_IDS=
# true  → only owner/admins + explicitly whitelisted users can talk to the bot
# false → open to everyone (public marketplace mode)
WHITELIST_ONLY=false

# ── Security ─────────────────────────────────────────────────────────────────
# HMAC secret for fail-closed MCP tool tokens & A2A calls (openssl rand -hex 32)
MCP_TOKEN_SECRET=change-me-please-openssl-rand-hex-32
# Optional separate secret for the A2A JSON-RPC endpoint. Empty = A2A disabled.
A2A_SECRET=
# Requests per minute per user
RATE_LIMIT_PER_MIN=30
# Max credits a non-owner user can spend per calendar day
DAILY_SPEND_LIMIT=500000
# Auto-expire pending HITL approvals after N minutes (fail-closed)
APPROVAL_TTL_MIN=60

# ── Web Dashboard ─────────────────────────────────────────────────────────────
# Owner key for the web dashboard "Owner" API (header X-KIA-Key).
# Empty → falls back to MCP_TOKEN_SECRET. Generate: openssl rand -hex 24
DASHBOARD_KEY=

# ── White-label Branding ──────────────────────────────────────────────────────
# One env var rebrands the ENTIRE instance (bot, dashboard, desktop).
# You can also override these live from the dashboard (Setting keys brand_*).
BRAND_NAME=My Awesome Bot
BRAND_TAGLINE=Your business, on autopilot
BRAND_FOOTER=Powered by My Awesome Bot

# ── AI Provider (OpenAI-compatible) ──────────────────────────────────────────
# Works with OpenAI, DeepSeek, GLM, Together, OpenRouter, local Ollama (http://host:11434/v1)…
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=800

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_MARKETPLACE=true
ENABLE_QUESTS=true
ENABLE_REFERRAL=true
ENABLE_BOOKINGS=true
# Competitor radar (scheduled web research jobs)
ENABLE_RADAR=false
# Daily report to owner
ENABLE_AUTO_REPORTS=true
REPORT_TZ=UTC

{
  "name": "kiadropagentx",
  "version": "1.5.1",
  "productName": "DropAgentX",
  "description": "XDrop (KIA DropAgentX) — The Ultimate Telegram Super-App: AI marketplace, wallet, quests, 6 AI agents, 15-layer security, HITL governance, MCP/A2A tooling and a live PWA dashboard.",
  "main": "desktop/main.js",
  "license": "MIT",
  "author": {
    "name": "KiaAgentX"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma db push --skip-generate && node dist/index.js",
    "start:node": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "tsx --test tests/*.test.ts",
    "setup": "npm install && prisma generate && prisma db push && tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "desktop": "electron desktop",
    "desktop:build": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "lenis": "^1.3.27",
    "node-cron": "^3.0.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1",
    "resedit": "^2.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
